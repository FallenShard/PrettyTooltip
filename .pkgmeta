package-as: PrettyTooltip

# The release notes, written by hand instead of listed from the commits.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - deploy.py
  - tools
  - art/*.py
  - art_unused
  - art/README.md
  - art/logo-400.png
  - tests
  - examples
  - output
  - README.md
  - ARCHITECTURE.md
  - UI/Capture.lua
